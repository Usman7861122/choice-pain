---
import LocationsSection from '../components/astro/LocationsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import PageCta from '../components/astro/PageCta.astro';
import Embed from '../components/astro/Embed.astro';
import { site } from '../data/content';
import { embeds } from '../data/thirdparty';
import { aboutImage } from '../data/images';
const values = [
  { t: 'Patients first', d: 'Everything we do is about helping people in pain get back to life.' },
  { t: 'A team that listens', d: 'We listen to patients and to each other, and we share what we know.' },
  { t: 'Care across 10 offices', d: 'Our offices across Maryland and Delaware let you work close to home.' },
];
---
<BaseLayout overlay title="Careers | Choice Pain & Rehabilitation Center" description="Join the team at CHOICE Pain & Rehabilitation Center. Contact us about opportunities across our Maryland and Delaware offices.">
  <PageHero eyebrow="Careers" title="Join a team that puts patients first" lede="We are always glad to hear from caring professionals who want to help people live with less pain." image={aboutImage} />
  <section class="section-pad bg-ivory">
    <div class="container-x">
      <div class="grid gap-6 md:grid-cols-3">
        {values.map((v, i) => (
          <div class="group rounded-md border border-accent/25 bg-white p-8 transition duration-500 hover:-translate-y-2 hover:bg-navy hover:shadow-2xl hover:shadow-navy/20">
            <p class="font-display text-5xl text-accent transition group-hover:text-accent-light">0{i + 1}</p>
            <h2 class="mt-3 text-3xl text-navy transition group-hover:text-white">{v.t}</h2>
            <p class="mt-2 text-muted transition group-hover:text-white/75">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section-pad bg-cream" aria-labelledby="apply-title">
    <div class="container-x mx-auto max-w-4xl">
      <div class="text-center"><p class="eyebrow">Apply</p><h2 id="apply-title" class="section-title">How to apply</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <div class="mt-12">
        <Embed iframe={embeds.careersForm.iframe} script={embeds.careersForm.script} title="Job application form">
          <div class="rounded-md border border-accent/25 bg-white p-10 text-center shadow-xl shadow-navy/10">
            <p class="text-lg text-muted">There are no open positions listed right now. To ask about openings, call or email our team and tell us a little about yourself.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a href={site.phoneHref} class="btn btn-appointment">Call {site.phone}</a>
              <a href={`mailto:${site.email}?subject=Career%20inquiry`} class="btn btn-outline">Email {site.email}</a>
            </div>
          </div>
        </Embed>
      </div>
    </div>
  </section>
  <LocationsSection />
  <PageCta title="Looking for care instead?" text="Request an appointment with our specialists." />
</BaseLayout>
