---
import { site } from '../../data/content';
import { locations } from '../../data/locations';
import { featuredServices } from '../../data/services';
const quick = [
  ['About Us', '/about-us'], ['Providers', '/providers'], ['Conditions', '/conditions'], ['GAE', '/genicular-artery-embolization'],
  ['Billing & Insurance', '/billing-insurance'], ['New Patient Forms', 'https://sa1s3.patientpop.com/assets/docs/291011.pdf'], ['Blog', '/blog'], ['Careers', '/careers'],
];
---
<footer class="relative overflow-hidden bg-navy text-white/80">
  <div class="pointer-events-none absolute -right-40 -top-40 h-96 w-96 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="flex flex-col items-start justify-between gap-6 border-b border-white/10 py-12 md:flex-row md:items-center">
      <div>
        <p class="eyebrow !text-accent-light">Ready when you are</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-white md:text-4xl">Take the first step toward a pain-free life.</h2>
      </div>
      <a href={site.appointmentHref} class="btn btn-appointment shrink-0">Request Appointment</a>
    </div>

    <div class="grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <span class="logo" style="height:64px"><img src="/images/logo/base-light.png" alt={site.name} class="logo-base" width="455" height="149" /><img src="/images/logo/icon-light.png" alt="" aria-hidden="true" class="logo-icon" /><span class="logo-ring" aria-hidden="true"></span></span>
        <p class="mt-5 max-w-xs text-sm leading-relaxed">Comprehensive, minimally invasive pain management for adults across Maryland and Delaware.</p>
        <a href={site.phoneHref} class="mt-5 block font-display text-2xl font-semibold text-accent-light">{site.phone}</a>
        <a href={`mailto:${site.email}`} class="text-sm hover:text-accent-light">{site.email}</a>
      </div>
      <nav aria-label="Quick links">
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-white">Quick Links</h3>
        <div class="accent-rule mt-3"></div>
        <ul class="mt-5 space-y-2.5 text-sm">{quick.map(([l, h]) => <li><a href={h} target={h.endsWith(".pdf") ? "_blank" : undefined} rel={h.endsWith(".pdf") ? "noopener noreferrer" : undefined} class="transition hover:text-accent-light">{l}</a></li>)}</ul>
      </nav>
      <nav aria-label="Services">
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-white">Services</h3>
        <div class="accent-rule mt-3"></div>
        <ul class="mt-5 space-y-2.5 text-sm">{featuredServices.map((s) => <li><a href={`/services/${s.slug}`} class="transition hover:text-accent-light">{s.title}</a></li>)}</ul>
      </nav>
      <nav aria-label="Locations">
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-white">Locations</h3>
        <div class="accent-rule mt-3"></div>
        <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">{locations.map((l) => <li><a href={`/locations/${l.slug}`} class="transition hover:text-accent-light">{l.name}</a></li>)}</ul>
      </nav>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/10 py-6 text-xs sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <li><a href="/privacy-policy" class="hover:text-accent-light">Privacy Policy</a></li>
        <li><a href="/terms-condition" class="hover:text-accent-light">Terms &amp; Conditions</a></li>
        <li><a href="/cookie-policy" class="hover:text-accent-light">Cookie Policy</a></li>
        <li><a href="/medical-disclaimer" class="hover:text-accent-light">Medical Disclaimer</a></li>
        <li><a href="/accessibility" class="hover:text-accent-light">Accessibility</a></li>
        <li><a href="/patient-privacy" class="hover:text-accent-light">Patient Rights</a></li>
        <li><button type="button" id="open-cookie-settings" class="hover:text-accent-light">Cookie Settings</button></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  document.getElementById('open-cookie-settings')?.addEventListener('click', () => window.dispatchEvent(new Event('open-cookie-settings')));
</script>
