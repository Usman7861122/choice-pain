---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PageCta from './PageCta.astro';
import LocationCards from './LocationCards.astro';
import FadeIn from '../react/FadeIn';
import { photoStatus } from '../../data/photo-status';
import { site } from '../../data/content';
import ServicesGrid from '../react/ServicesGrid';
import { serviceImages } from '../../data/images';
const { p, loc: locSlug } = Astro.props;
import { locations } from '../../data/locations';
import { localAreas } from '../../data/local-areas';
const loc = locSlug ? locations.find((l) => l.slug === locSlug) : undefined;
const local = locSlug ? localAreas[locSlug] : undefined;
const here = loc && local;
const base = `/conditions/${p.slug}`;
const list = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}` : a[0]);
const ph = (i: number) => ({ src: p.photos[i].img, alt: p.photos[i].alt, st: photoStatus(p.photos[i].img) });
const txItems = p.treatment.services.map((t) => ({ ...t, img: serviceImages[t.slug] }));
const strip = here ? `Patients are welcome from across ${list(local!.areas)} and the greater ${local!.city} area.` : 'Patients are welcome from across Maryland and Delaware, including Hyattsville, Gaithersburg, Baltimore, Newark, Milford and the surrounding areas.';
const h1 = here ? `${p.title} in ${local!.city}` : p.title;
const metaTitle = here ? `${p.title} Treatment in ${loc!.name} | Choice Pain & Rehabilitation Center` : p.metaTitle;
const metaDescription = here ? `${p.title} care in ${loc!.name}. We find the source of your pain and offer the least invasive treatment that works. Call ${site.phone}.` : p.metaDescription;
const lede = here ? `${p.lede} Patients visit our ${local!.city} office from ${local!.areas.slice(0, 4).join(', ')} and nearby.` : p.lede;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const medSchema = { '@context': 'https://schema.org', '@type': 'MedicalCondition', name: p.title, description: p.metaDescription, possibleTreatment: p.treatment.services.map((t) => ({ '@type': 'MedicalTherapy', name: t.title })) };
---
<BaseLayout overlay title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medSchema)} />
  <PageHero eyebrow={here ? `Conditions · ${loc!.name}` : "Conditions · Maryland & Delaware"} title={h1} accent={here ? local!.city : undefined} strip={strip} lede={lede} image={ph(0).src} alt={ph(0).alt}>
    <div class="mt-8 flex flex-wrap gap-3"><a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a><a href={site.phoneHref} class="btn btn-light">Call {site.phone}</a></div>
  </PageHero>

  <section class="section-pad bg-ivory" aria-labelledby="ov-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <FadeIn client:visible>
        <p class="eyebrow">Overview</p>
        <h2 id="ov-title" class="section-title mt-3">{p.overview.title}</h2>
        <div class="accent-rule mt-6"></div>
        {p.overview.text.map((t) => <p class="mt-5 text-lg leading-relaxed text-muted">{t}</p>)}
      </FadeIn>
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={ph(1).src} data-photo-status={ph(1).st} alt={ph(1).alt} class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-pad relative isolate overflow-hidden bg-navy text-white" aria-labelledby="cause-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[1.2fr_0.8fr] lg:gap-20">
      <div>
        <p class="eyebrow !text-accent-light">Causes</p>
        <h2 id="cause-title" class="mt-3 font-display text-4xl text-white md:text-5xl">{p.causes.title}</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-white/80">{p.causes.text}</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {p.causes.items.map((c) => (
            <div class="rounded-md border border-white/15 bg-gradient-to-br from-white/10 to-white/[0.03] p-7 backdrop-blur-md transition duration-500 hover:-translate-y-1 hover:border-accent-light/60">
              <h3 class="font-display text-2xl text-accent-light">{c.title}</h3>
              <p class="mt-3 text-white/80">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="overflow-hidden rounded-md shadow-2xl shadow-black/40"><img src={ph(2).src} data-photo-status={ph(2).st} alt={ph(2).alt} class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="sym-title">
    <div class="container-x grid items-start gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20 lg:sticky lg:top-28 lg:self-start"><img src={ph(3).src} data-photo-status={ph(3).st} alt={ph(3).alt} class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Symptoms</p>
        <h2 id="sym-title" class="section-title mt-3">{p.symptoms.title}</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg text-muted">{p.symptoms.text}</p>
        <div class="mt-8 overflow-hidden rounded-md border border-accent/25 bg-white shadow-xl shadow-navy/10">
          <div class="p-7 md:p-8">
            <h3 class="font-display text-2xl text-navy">Signs we hear about often</h3>
            <ul class="mt-4 divide-y divide-accent/15">{p.symptoms.items.map((i) => <li class="flex gap-3 py-3.5 text-ink"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{i}</li>)}</ul>
          </div>
          <div class="border-t-2 border-accent/30 bg-gradient-to-b from-accent/[0.07] to-accent/[0.02] p-7 md:p-8">
            <h3 class="flex items-center gap-3 font-display text-2xl text-accent">
              <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z" stroke-linejoin="round"/><path d="M12 10v4M12 17v.5" stroke-linecap="round"/></svg>
              Get urgent care right away if you have
            </h3>
            <ul class="mt-4 divide-y divide-accent/15">{p.symptoms.redFlags.map((i) => <li class="flex gap-3 py-3.5 text-ink"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{i}</li>)}</ul>
            <p class="mt-4 text-sm text-muted">In an emergency, call 911 or go to the nearest emergency room.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-ivory" aria-labelledby="dx-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Diagnosis</p>
        <h2 id="dx-title" class="section-title mt-3">{p.diagnosis.title}</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg text-muted">{p.diagnosis.text}</p>
        <ol class="relative mt-8 space-y-8 border-l border-accent/30 pl-8">
          {p.diagnosis.steps.map((st, i) => (
            <li class="relative">
              <span class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-2 border-accent bg-ivory"></span>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Step {i + 1}</p>
              <h3 class="mt-1 font-display text-2xl text-navy">{st.title}</h3>
              <p class="mt-2 text-muted">{st.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={ph(4).src} data-photo-status={ph(4).st} alt={ph(4).alt} class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-pad relative isolate overflow-hidden bg-navy text-white" aria-labelledby="tx-title">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow !text-accent-light">Treatment</p>
        <h2 id="tx-title" class="font-display text-4xl text-white md:text-5xl">{p.treatment.title}</h2>
        <div class="accent-rule mx-auto mt-6"></div>
        <p class="mt-6 text-lg text-white/80">{p.treatment.text}</p>
      </div>
      {txItems.length > 0 && <div class="mt-14"><ServicesGrid client:visible items={txItems} /></div>}
      <div class="mx-auto mt-12 max-w-3xl rounded-md border border-white/15 p-7">
        <h3 class="font-display text-2xl text-white">Other parts of your care plan</h3>
        <ul class="mt-4 space-y-2">{p.treatment.other.map((i) => <li class="flex gap-3 text-white/80"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-light"></span>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="live-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={ph(5).src} data-photo-status={ph(5).st} alt={ph(5).alt} class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Living well</p>
        <h2 id="live-title" class="section-title mt-3">{p.livingWell.title}</h2>
        <div class="accent-rule mt-6"></div>
        <ul class="mt-6 space-y-3">{p.livingWell.tips.map((t) => <li class="flex gap-3 text-lg text-muted"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section-pad bg-ivory" aria-labelledby="faq-title">
    <div class="container-x grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="eyebrow">FAQ</p><h2 id="faq-title" class="section-title mt-3">Common questions</h2><div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg text-muted">Related conditions we treat:</p>
        <div class="mt-4 flex flex-wrap gap-3">{p.related.map((r) => <a href={`/conditions/${r.slug}`} class="rounded-full border border-accent/40 px-5 py-2 text-navy transition hover:bg-accent hover:text-white">{r.title}</a>)}</div>
      </div>
      <div class="divide-y divide-accent/20 rounded-md border border-accent/25 bg-white">
        {p.faqs.map((f) => (
          <details class="group p-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-navy">{f.q}<span class="text-2xl text-accent transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 text-muted">{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <LocationCards title={p.title} base={base} loc={locSlug} />
  <PageCta title={`Ready to get help with ${p.title.toLowerCase()}?`} text="Call us or request an appointment. We will find the cause and plan the gentlest treatment that works." />
</BaseLayout>
