---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import AppointmentForm from '../components/react/AppointmentForm';
import { locations } from '../data/locations';
import { conditions } from '../data/conditions';
import { site } from '../data/content';
const locOpts = locations.map((l) => ({ value: l.slug, label: l.name }));
const concernOpts = conditions.map((c) => ({ value: c.slug, label: c.title }));
const steps = [
  ['Send your request', 'Tell us who you are, which office you like and when you are free.'],
  ['We call you', 'Our team calls to confirm a time and answers your questions.'],
  ['Bring your papers', 'Download the new patient forms, fill them in, and bring your ID and insurance card.'],
];
---
<BaseLayout overlay title="Request an Appointment | Choice Pain & Rehabilitation Center" description="Request a pain management appointment at any of our 10 offices in Maryland and Delaware. Fill in the short form or call (240) 786-1001.">
  <PageHero eyebrow="Appointments" title="Request an Appointment" accent="Appointment" lede="Tell us where you hurt and when you are free. Our team will call you to book your visit." image="/images/stock/2756848849.webp" alt="Doctor explaining a spine model to a patient" />
  <section class="section-pad bg-ivory">
    <div class="container-x grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <AppointmentForm client:load locations={locOpts} concerns={concernOpts} email={site.email} phone={site.phone} endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT} />
      <aside class="space-y-6 lg:sticky lg:top-28">
        <div class="rounded-md bg-navy p-8 text-white">
          <p class="eyebrow !text-accent-light">Prefer to call?</p>
          <a href={site.phoneHref} class="mt-3 block font-display text-4xl hover:text-accent-light">{site.phone}</a>
          <p class="mt-3 text-white/75">Our team can book you right away. Same number for all 10 offices.</p>
          <a href="/locations" class="btn btn-light mt-6">See office hours</a>
        </div>
        <div class="rounded-md border border-accent/25 bg-white p-8">
          <h2 class="font-display text-3xl text-navy">What happens next</h2>
          <div class="accent-rule mt-4"></div>
          <ol class="mt-6 space-y-5">
            {steps.map(([t, x], i) => (
              <li class="flex gap-4"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent font-semibold text-white">{i + 1}</span><div><h3 class="font-semibold text-navy">{t}</h3><p class="text-muted">{x}</p></div></li>
            ))}
          </ol>
          <a href="https://sa1s3.patientpop.com/assets/docs/291011.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-6">New Patient Forms (PDF)</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
