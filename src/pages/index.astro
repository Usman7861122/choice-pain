---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/react/HeroSlider';
import ServicesGrid from '../components/react/ServicesGrid';
import VideoPlayer from '../components/react/VideoPlayer';
import Testimonials from '../components/react/Testimonials';
import LocationsTabs from '../components/react/LocationsTabs';
import FadeIn from '../components/react/FadeIn';
import { site, heroText, aboutPoints, gaePoints } from '../data/content';
import { posts } from '../data/blog';
const blogPosts = posts.slice(0, 3).map((b) => ({ slug: b.slug, tag: b.category, title: b.title, text: b.excerpt, image: b.image, fallback: b.fallback }));
import { heroSlides, aboutImage, parallaxImage, gaeSectionImage, serviceImages, blogImages } from '../data/images';
import { featuredServices } from '../data/services';
import { doctors, aboutVideo, insurers, testimonials } from '../data/assets';
import { locations } from '../data/locations';

const slides = heroSlides.map((s, i) => ({ ...s, ...heroText[i] }));
const services = featuredServices.map((s) => ({ ...s, img: serviceImages[s.slug] }));
const initials = (n: string) => n.split(/[ ,]+/).filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
---
<BaseLayout overlay title="Pain Management in Maryland & Delaware | CHOICE Pain & Rehabilitation Center">
  <HeroSlider client:load slides={slides} ctaHref={site.appointmentHref} phone={site.phone} phoneHref={site.phoneHref} />

  <!-- About -->
  <section class="section-pad relative overflow-hidden bg-ivory" aria-labelledby="about-title">
    <span class="pointer-events-none absolute -left-10 top-6 select-none font-display text-[16rem] font-extrabold leading-none text-accent/[0.06]" aria-hidden="true">C</span>
    <div class="container-x relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <FadeIn client:visible>
        <p class="eyebrow">About Choice Pain</p>
        <h2 id="about-title" class="section-title">A trusted team for acute and chronic pain</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-muted">With offices across Maryland and Delaware, the specialists at CHOICE Pain &amp; Rehabilitation Center offer a full range of solutions for men and women living with acute and chronic pain.</p>
        <p class="mt-4 leading-relaxed text-muted">Each provider has specialized training in pain management and uses a multidisciplinary approach, from injection therapy to physical therapy, to support your physical and emotional well-being.</p>
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-accent/30 pt-8">
          {aboutPoints.map((p) => (
            <div><dt class="font-display text-4xl font-semibold text-navy">{p.n}</dt><dd class="mt-1 text-xs uppercase tracking-widest text-muted">{p.label}</dd></div>
          ))}
        </dl>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/about-us" class="btn btn-outline">Learn More About Us</a>
          <a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.15}>
        <div class="group relative mx-auto max-w-xl">
          <div class="absolute -bottom-5 -right-5 h-full w-full rounded-md border border-accent/60 transition-all duration-700 ease-[var(--ease-lux)] group-hover:-bottom-2 group-hover:-right-2 group-hover:border-accent" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-md shadow-2xl shadow-navy/20 transition-shadow duration-700 group-hover:shadow-navy/40">
            <img src={aboutImage} alt="Doctor warmly greeting a patient at a Choice Pain office" class="img-sq transition-transform duration-[1400ms] ease-out group-hover:scale-110" loading="lazy" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/40 via-transparent to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>
            <span class="pointer-events-none absolute inset-3 rounded-sm border border-white/0 transition-colors duration-700 group-hover:border-white/60"></span>
          </div>
          <div class="absolute -left-4 bottom-8 hidden rounded-md bg-navy px-6 py-4 text-white shadow-xl transition-transform duration-700 group-hover:-translate-y-2 group-hover:translate-x-2 sm:block">
            <p class="font-display text-lg font-semibold">Personalized care</p>
            <p class="text-xs uppercase tracking-widest text-accent-light">Every step of the way</p>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Services -->
  <section class="section-pad bg-cream" aria-labelledby="services-title">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Our Services</p>
        <h2 id="services-title" class="section-title">Six ways we treat pain at its source</h2>
        <div class="accent-rule mx-auto mt-6"></div>
        <p class="mt-6 text-lg text-muted">Every plan starts with the least invasive option likely to work.</p>
      </div>
      <div class="mt-14"><ServicesGrid client:visible items={services} /></div>
      <div class="mt-14 text-center"><a href="/services" class="btn btn-outline">View All Services</a></div>
    </div>
  </section>

  <!-- Parallax -->
  <section class="parallax relative flex min-h-[85vh] items-end justify-center" style={`background-image:url(${parallaxImage})`} aria-labelledby="reclaim-title">
    <div class="absolute inset-0 bg-gradient-to-t from-navy/85 via-navy/20 to-transparent"></div>
    <div class="container-x relative pb-16 text-center md:pb-24">
      <p class="eyebrow justify-center !text-accent-light">Live fully again</p>
      <h2 id="reclaim-title" class="mx-auto mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight text-white md:text-6xl">Reclaim Your Life Pain-Free</h2>
      <div class="mt-8 flex justify-center"><a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a></div>
    </div>
  </section>

  <!-- GAE -->
  <section class="section-pad relative overflow-hidden bg-ivory" aria-labelledby="gae-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <FadeIn client:visible>
        <div class="group relative mx-auto max-w-xl">
          <div class="absolute -left-5 -top-5 h-full w-full rounded-md border border-accent/60 transition-all duration-700 ease-[var(--ease-lux)] group-hover:-left-2 group-hover:-top-2 group-hover:border-accent" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-md shadow-2xl shadow-navy/20 transition-shadow duration-700 group-hover:shadow-navy/40">
            <video class="gae-video img-sq transition-transform duration-[1400ms] ease-out group-hover:scale-105" autoplay muted loop playsinline preload="metadata" poster="/videos/gae-poster.webp" aria-label="Animation showing how Genicular Artery Embolization calms knee inflammation" width="1080" height="1080">
              <source src="/videos/gae.webm" type="video/webm" />
              <source src="/videos/gae.mp4" type="video/mp4" />
            </video>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy/50 via-transparent to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>
            <span class="pointer-events-none absolute inset-3 rounded-sm border border-white/0 transition-colors duration-700 group-hover:border-white/60"></span>
            <p class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-4 p-6 font-display text-lg font-semibold text-white opacity-0 transition-all duration-700 group-hover:translate-y-0 group-hover:opacity-100">How GAE calms knee pain</p>
          </div>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.15}>
        <p class="eyebrow">Knee Pain Solution</p>
        <h2 id="gae-title" class="section-title">Genicular Artery Embolization (GAE)</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-muted">GAE is a minimally invasive option for people with chronic knee pain. It aims to calm the inflammation behind the pain, without major surgery.</p>
        <ul class="mt-8 space-y-4">
          {gaePoints.map((p) => (
            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-accent text-accent" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 6l3 3 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="text-ink">{p}</span>
            </li>
          ))}
        </ul>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/genicular-artery-embolization" class="btn btn-outline">Learn About GAE</a>
          <a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- Doctors -->
  <section class="section-pad bg-cream" aria-labelledby="doctors-title">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Our Providers</p>
        <h2 id="doctors-title" class="section-title">Meet our doctors</h2>
        <div class="accent-rule mx-auto mt-6"></div>
        <p class="mt-6 text-lg text-muted">Experienced, caring specialists focused on lasting relief.</p>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {doctors.map((d, i) => (
          <FadeIn client:visible delay={i * 0.12}>
            <article class="group overflow-hidden rounded-md border border-accent/25 bg-white shadow-sm transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-navy/15">
              <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-navy-800 to-navy-700">
                <span class="absolute inset-0 flex items-center justify-center font-display text-7xl font-semibold text-accent-light/60" aria-hidden="true">{initials(d.name)}</span>
                <img src={d.img} alt={d.name} loading="lazy" class="relative h-full w-full object-cover object-top transition duration-[1200ms] group-hover:scale-105" onerror="this.style.display='none'" />
              </div>
              <div class="p-7 text-center">
                <h3 class="text-xl font-semibold text-navy">{d.name}</h3>
                <p class="mt-1 text-sm uppercase tracking-widest text-accent">{d.role}</p>
                <div class="accent-rule mx-auto my-5"></div>
                <a href={`/providers/${d.slug}`} class="btn btn-outline">Read More</a>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section-pad relative overflow-hidden bg-navy text-white" aria-labelledby="video-title">
    <div class="pointer-events-none absolute -left-32 top-1/3 h-96 w-96 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
      <FadeIn client:visible>
        <p class="eyebrow !text-accent-light">Get to know us</p>
        <h2 id="video-title" class="mt-4 font-display text-3xl font-semibold leading-tight md:text-5xl">A look inside Choice Pain</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-white/80">Hear how our team approaches pain care: listening first, explaining your options clearly, and building a plan together.</p>
        <a href={site.appointmentHref} class="btn btn-light mt-8">Request Appointment</a>
      </FadeIn>
      <FadeIn client:visible delay={0.15}><VideoPlayer client:visible src={aboutVideo} title="About CHOICE Pain & Rehabilitation Center" /></FadeIn>
    </div>
  </section>

  <!-- Insurance -->
  <section class="section-pad bg-white" aria-labelledby="ins-title">
    <div class="container-x text-center">
      <p class="eyebrow justify-center">Insurance</p>
      <h2 id="ins-title" class="section-title">Most Major Insurance Plans Accepted</h2>
      <div class="accent-rule mx-auto mt-6"></div>
      <p class="mx-auto mt-6 max-w-2xl text-muted">We see patients from all insurance providers, though we may not be contracted with every plan. Call us to confirm your coverage.</p>
    </div>
    <div class="marquee relative mt-12 overflow-hidden" aria-label="Accepted insurance plans">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white to-transparent"></div>
      <ul class="marquee-track flex items-center gap-6">
        {[...insurers, ...insurers].map((n, i) => (
          <li class="flex h-24 w-48 shrink-0 items-center justify-center rounded-md border border-accent/25 bg-ivory p-5" aria-hidden={i >= insurers.length}>
            <img src={n.src} alt={i < insurers.length ? n.name : ''} class="max-h-full max-w-full object-contain" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'font-display font-semibold capitalize text-navy',textContent:this.alt||''}))" />
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-12 text-center"><a href="/billing-insurance" class="btn btn-outline">Billing &amp; Insurance</a></div>
  </section>

  <!-- Testimonials -->
  <section class="section-pad relative overflow-hidden bg-navy-800" aria-labelledby="testi-title">
    <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative">
      <div class="mb-12 text-center">
        <p class="eyebrow justify-center !text-accent-light">Testimonials</p>
        <h2 id="testi-title" class="mt-4 font-display text-3xl font-semibold text-white md:text-5xl">What our patients say</h2>
      </div>
      <Testimonials client:visible items={testimonials} />
      <div class="mt-12 text-center"><a href="/testimonials" class="btn btn-light">Read More Reviews</a></div>
    </div>
  </section>

  <!-- Blog -->
  <section class="section-pad bg-cream" aria-labelledby="blog-title">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">From Our Blog</p>
        <h2 id="blog-title" class="section-title">Pain care insights and advice</h2>
        <div class="accent-rule mx-auto mt-6"></div>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {blogPosts.map((b, i) => (
          <FadeIn client:visible delay={i * 0.12}>
            <article class="group h-full overflow-hidden rounded-md border border-accent/25 bg-white shadow-sm transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-navy/15">
              <a href={`/blog/${b.slug}`} class="block" aria-label={b.title}>
                <div class="relative aspect-square overflow-hidden">
                  <img src={b.image} data-fb={b.fallback} onerror="this.onerror=null;this.src=this.dataset.fb" alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110" />
                  <span class="absolute left-4 top-4 rounded-md bg-navy/85 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-light backdrop-blur">{b.tag}</span>
                </div>
              </a>
              <div class="p-7">
                <h3 class="font-display text-xl font-semibold leading-snug text-navy"><a href={`/blog/${b.slug}`} class="transition hover:text-accent">{b.title}</a></h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">{b.text}</p>
                <a href={`/blog/${b.slug}`} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-all hover:gap-3 hover:text-navy">Read More <span aria-hidden="true">→</span></a>
              </div>
            </article>
          </FadeIn>
        ))}
      </div>
      <div class="mt-14 text-center"><a href="/blog" class="btn btn-outline">View All Articles</a></div>
    </div>
  </section>

  <!-- Locations -->
  <section class="section-pad bg-ivory" aria-labelledby="loc-title" id="locations">
    <div class="container-x">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <p class="eyebrow">Locations</p>
        <h2 id="loc-title" class="section-title">Ten offices across Maryland &amp; Delaware</h2>
        <div class="accent-rule mx-auto mt-6"></div>
      </div>
      <LocationsTabs client:visible locations={locations} phone={site.phone} phoneHref={site.phoneHref} email={site.email} />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.gae-video').forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
