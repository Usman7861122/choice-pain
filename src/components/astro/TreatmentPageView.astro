---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PageCta from './PageCta.astro';
import LocationCards from './LocationCards.astro';
import FadeIn from '../react/FadeIn';
import ServicesGrid from '../react/ServicesGrid';
import { photoStatus } from '../../data/photo-status';
import { site } from '../../data/content';
import { treatmentList, treatmentAlt } from '../../data/treatments';
const { t, loc: locSlug } = Astro.props;
import { locations } from '../../data/locations';
import { localAreas } from '../../data/local-areas';
const loc = locSlug ? locations.find((l) => l.slug === locSlug) : undefined;
const local = locSlug ? localAreas[locSlug] : undefined;
const here = loc && local;
const list = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}` : a[0]);
const src = (i: number) => `/images/stock/${t.ph[i]}.webp`;
const st = (i: number) => photoStatus(src(i));
const alt = (i: number) => treatmentAlt(t.ph[i]);
const metaTitle = here ? `${t.title} in ${loc!.name} | Choice Pain & Rehabilitation Center` : `${t.title} in Maryland & Delaware | Choice Pain & Rehabilitation Center`;
const metaDescription = here ? `${t.title} in ${loc!.name}. ${t.short} Call ${site.phone}.`.slice(0, 200) : `${t.short} Offered at 10 Choice Pain offices in Maryland and Delaware.`.slice(0, 200);
const h1 = here ? `${t.title} in ${local!.city}` : t.title;
const strip = here ? `Patients are welcome from across ${list(local!.areas)} and the greater ${local!.city} area.` : 'Patients are welcome from across Maryland and Delaware, including Hyattsville, Gaithersburg, Baltimore, Newark, Milford and the surrounding areas.';
const related = t.rel.map((s) => treatmentList.find((x) => x.slug === s)!).map((x) => ({ slug: x.slug, title: x.title, text: x.short, img: `/images/stock/${x.ph[0]}.webp` }));
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: t.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const medSchema = { '@context': 'https://schema.org', '@type': 'MedicalProcedure', name: t.title, description: metaDescription, procedureType: 'https://schema.org/PercutaneousProcedure' };
---
<BaseLayout overlay title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medSchema)} />
  <PageHero eyebrow={here ? `Treatment · ${loc!.name}` : `Treatment · ${t.group}`} title={h1} accent={here ? local!.city : undefined} strip={strip} lede={here ? `${t.lede} Patients visit our ${local!.city} office from ${local!.areas.slice(0, 4).join(', ')} and nearby.` : t.lede} image={src(0)} alt={alt(0)}>
    <div class="mt-8 flex flex-wrap gap-3"><a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a><a href={site.phoneHref} class="btn btn-light">Call {site.phone}</a></div>
  </PageHero>

  <section class="section-pad bg-ivory" aria-labelledby="t-ov">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <FadeIn client:visible>
        <p class="eyebrow">Overview</p>
        <h2 id="t-ov" class="section-title mt-3">What is {t.title}?</h2>
        <div class="accent-rule mt-6"></div>
        {t.ov.map((x) => <p class="mt-5 text-lg leading-relaxed text-muted">{x}</p>)}
        {t.svc && <p class="mt-6"><a href={`/services/${t.svc}`} class="font-semibold text-accent underline-offset-4 hover:underline">Learn more about our related service →</a></p>}
      </FadeIn>
      {t.video ? (
        <div class="group relative mx-auto w-full max-w-xl">
          <div class="absolute -left-5 -top-5 h-full w-full rounded-md border border-accent/60 transition-all duration-700 group-hover:-left-2 group-hover:-top-2 group-hover:border-accent" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-md shadow-2xl shadow-navy/20 transition-shadow duration-700 group-hover:shadow-navy/40">
            <video class="gae-video aspect-square w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" autoplay muted loop playsinline preload="metadata" poster="/videos/gae-poster.webp" aria-label="Animation showing how Genicular Artery Embolization calms knee inflammation" width="1080" height="1080">
              <source src="/videos/gae.webm" type="video/webm" />
              <source src="/videos/gae.mp4" type="video/mp4" />
            </video>
            <span class="pointer-events-none absolute inset-3 rounded-sm border border-white/0 transition-colors duration-700 group-hover:border-white/60"></span>
          </div>
        </div>
        <script is:inline>
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { document.querySelectorAll('.gae-video').forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); }); }
        </script>
      ) : (
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={src(1)} data-photo-status={st(1)} alt={alt(1)} class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
      )}
    </div>
  </section>

  <section class="section-pad relative isolate overflow-hidden bg-navy text-white" aria-labelledby="t-fit">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="overflow-hidden rounded-md shadow-2xl shadow-black/40"><img src={src(2)} data-photo-status={st(2)} alt={alt(2)} class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
      <div>
        <p class="eyebrow !text-accent-light">Candidates</p>
        <h2 id="t-fit" class="mt-3 font-display text-4xl text-white md:text-5xl">Is {t.title} right for you?</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-white/80">Your doctor decides after an exam and a review of your history and scans. It is often considered for people with these problems.</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {[['Conditions treated', t.cond], ['Common symptoms', t.sym]].map(([h, list]) => (
            <div class="rounded-md border border-white/15 bg-gradient-to-br from-white/10 to-white/[0.03] p-7 backdrop-blur-md">
              <h3 class="font-display text-2xl text-accent-light">{h}</h3>
              <ul class="mt-4 space-y-3">{(list as string[]).map((i) => <li class="flex gap-3 text-white/85"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-light"></span>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="t-ben">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center"><p class="eyebrow">Benefits</p><h2 id="t-ben" class="section-title">Why patients choose it</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {t.ben.map(([h, x], i) => (
          <FadeIn client:visible delay={i * 0.1}>
            <div class="h-full rounded-md border border-accent/25 bg-white p-8 transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-navy/15">
              <span class="font-display text-5xl text-accent/40">0{i + 1}</span>
              <h3 class="mt-3 font-display text-2xl text-navy">{h}</h3>
              <p class="mt-3 text-muted">{x}</p>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad bg-ivory" aria-labelledby="t-rec">
    <div class="container-x grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div><p class="eyebrow">What to expect</p><h2 id="t-rec" class="section-title mt-3">Your visit, step by step</h2><div class="accent-rule mt-6"></div><p class="mt-6 text-lg leading-relaxed text-muted">Every plan is personal. This is a general picture of what the day may look like, and your care team will give you exact instructions.</p></div>
      <ol class="relative space-y-8 border-l border-accent/30 pl-8">
        {t.rec.map(([label, title, text]) => (
          <li class="relative">
            <span class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-2 border-accent bg-ivory"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">{label}</p>
            <h3 class="mt-1 font-display text-2xl text-navy">{title}</h3>
            <p class="mt-2 text-muted">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="t-faq">
    <div class="container-x grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Safety</p><h2 class="section-title mt-3">Safety and risks</h2><div class="accent-rule mt-6"></div>
        <p class="mt-5 text-lg leading-relaxed text-muted">{t.safety}</p>
        <p class="mt-4 text-lg leading-relaxed text-muted">Always tell your doctor about your medicines, especially blood thinners, and any allergies before a procedure.</p>
      </div>
      <div>
        <p class="eyebrow">FAQ</p><h2 id="t-faq" class="section-title mt-3">Common questions</h2>
        <div class="mt-8 divide-y divide-accent/20 rounded-md border border-accent/25 bg-white">
          {t.faqs.map(([q, a]) => (
            <details class="group p-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-navy">{q}<span class="text-2xl text-accent transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 text-muted">{a}</p></details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <LocationCards title={t.title} base={t.path || `/treatment/${t.slug}`} loc={locSlug} />

  <section class="section-pad bg-cream" aria-labelledby="t-more">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow">Related</p><h2 id="t-more" class="section-title">Related treatments</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <ServicesGrid client:visible items={related} base="/treatment" />
    </div>
  </section>
  <PageCta />
</BaseLayout>
