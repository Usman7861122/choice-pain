---
import LocationsSection from '../components/astro/LocationsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import PageCta from '../components/astro/PageCta.astro';
import Embed from '../components/astro/Embed.astro';
import FadeIn from '../components/react/FadeIn';
import { site } from '../data/content';
import { insurers } from '../data/assets';
import { brochureUrl, embeds } from '../data/thirdparty';
import { aboutImage } from '../data/images';
const cards = [
  { t: 'Office hours', d: 'Monday through Friday, 9 a.m. to 5 p.m.', i: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
  { t: 'Your first visit', d: 'Please arrive about 15 minutes early to finish your intake paperwork.', i: 'M9 12.5 11 14.500 15.500 10M12 3 4.500 6v5.500c0 4.400 3 7.900 7.500 9.500 4.500-1.600 7.500-5.100 7.500-9.500V6L12 3Z' },
  { t: 'Cancellations', d: 'We are busy, and new appointments can take days. Please call at least 48 hours ahead so someone else in pain can take your spot.', i: 'M8 3v3M16 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z' },
  { t: 'Prescriptions & refills', d: 'Refills are handled only during office hours. Please call at least 48 hours before you need one.', i: 'M10.500 20.500 3.500 13.500a4.900 4.900 0 0 1 7-7l7 7a4.900 4.900 0 0 1-7 7ZM8 8l7 7' },
];
---
<BaseLayout overlay title="Billing & Insurance | Choice Pain & Rehabilitation Center" description="Office hours, insurance, cancellations, refills and billing questions for CHOICE Pain & Rehabilitation Center.">
  <PageHero eyebrow="Billing & Insurance" title="Clear answers about cost and coverage" lede="We accept patients with all insurance providers and will work with you on your medical and financial needs." image={aboutImage} />

  <section class="section-pad bg-ivory">
    <div class="container-x">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map((c, i) => (
          <FadeIn client:visible delay={i * 0.08}>
            <div class="group h-full rounded-md border border-accent/25 bg-white p-7 transition duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-navy/10">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-cream text-accent ring-1 ring-accent/20 transition duration-500 group-hover:bg-navy group-hover:text-accent-light">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.i}/></svg>
              </span>
              <h2 class="mt-5 text-3xl text-navy">{c.t}</h2>
              <p class="mt-2 text-muted">{c.d}</p>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad relative overflow-hidden bg-navy text-white" aria-labelledby="ins-title">
    <div class="pointer-events-none absolute -left-20 bottom-0 h-80 w-80 rounded-full bg-accent/25 blur-3xl"></div>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow !text-accent-light">Insurance</p>
        <h2 id="ins-title" class="mt-4 font-display text-4xl font-light md:text-6xl">All insurers welcome</h2>
        <p class="mt-6 text-lg leading-relaxed text-white/80">We may not be contracted with every plan, so please call before your visit to confirm your coverage. We will do our best to fit your financial situation.</p>
        <p class="mt-4 text-lg text-white/80">Insurance and billing questions: <a class="text-accent-light underline-offset-4 hover:underline" href={site.phoneHref}>{site.phone}</a></p>
      </div>
      <ul class="grid grid-cols-3 gap-3">
        {insurers.map((n) => (<li class="flex h-20 items-center justify-center rounded-md bg-white p-3"><img src={n.src} alt={n.name} class="max-h-full max-w-full object-contain" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'text-xs font-semibold capitalize text-navy',textContent:this.alt||''}))" /></li>))}
      </ul>
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="docs-title">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center"><p class="eyebrow">Forms &amp; Payments</p><h2 id="docs-title" class="section-title">Get ready for your visit</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-3">
        <a href="https://sa1s3.patientpop.com/assets/docs/291011.pdf" target="_blank" rel="noopener noreferrer" class="group rounded-md border border-accent/25 bg-white p-7 text-center transition duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-navy/10"><h3 class="text-3xl text-navy">New patient forms</h3><p class="mt-2 text-muted">English</p><span class="mt-4 inline-block text-sm font-medium text-accent group-hover:underline">Open forms →</span></a>
        <a href="https://sa1s3.patientpop.com/assets/docs/93194.pdf" target="_blank" rel="noopener noreferrer" class="group rounded-md border border-accent/25 bg-white p-7 text-center transition duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-navy/10"><h3 class="text-3xl text-navy">Formularios</h3><p class="mt-2 text-muted">Español</p><span class="mt-4 inline-block text-sm font-medium text-accent group-hover:underline">Abrir formularios →</span></a>
        <a href={brochureUrl} target="_blank" rel="noopener" class="group rounded-md border border-accent/25 bg-white p-7 text-center transition duration-500 hover:-translate-y-2 hover:shadow-xl hover:shadow-navy/10"><h3 class="text-3xl text-navy">Our brochure</h3><p class="mt-2 text-muted">PDF</p><span class="mt-4 inline-block text-sm font-medium text-accent group-hover:underline">Download →</span></a>
      </div>
      <div class="mx-auto mt-12 max-w-3xl">
        <Embed iframe={embeds.billPay.iframe} script={embeds.billPay.script} title="Patient payment portal" />
      </div>
    </div>
  </section>
  <LocationsSection />
  <PageCta title="Questions about your bill?" text="Our business office is happy to help." />
</BaseLayout>
