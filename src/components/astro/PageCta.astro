---
import { site } from '../../data/content';
interface Props { title?: string; text?: string }
const { title = 'Start your path to comfort', text = 'Request an appointment online or call our team. We are glad to help.' } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-navy py-20 text-center text-white">
  <div class="pointer-events-none absolute -left-24 top-0 -z-10 h-72 w-72 rounded-full bg-accent/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 -z-10 h-72 w-72 rounded-full bg-accent-light/15 blur-3xl"></div>
  <div class="container-x">
    <h2 class="font-display text-4xl font-light md:text-6xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/80">{text}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a>
      <a href={site.phoneHref} class="btn btn-light">Call {site.phone}</a>
    </div>
  </div>
</section>
