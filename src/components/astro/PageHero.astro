---
interface Props { eyebrow: string; title: string; lede?: string; image: string; alt?: string; fallback?: string; accent?: string; strip?: string }
const { eyebrow, title, lede, image, alt = '', fallback, accent, strip } = Astro.props;
import { photoStatus } from "../../data/photo-status";
const status = photoStatus(image);
const isTemp = new RegExp('/[0-9]{13}\\.webp$').test(image); // temporary Unsplash photo (see scripts/UNSPLASH-TEMP-PHOTOS.md)
---
<section class="relative isolate overflow-hidden bg-navy pb-20 pt-44 md:pb-28">
  <img src={image} data-temp-photo={isTemp ? "unsplash" : undefined} data-photo-status={status} alt={alt} data-fb={fallback} onerror={fallback ? "this.onerror=null;this.src=this.dataset.fb" : undefined} class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/40"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-navy/70 to-transparent"></div>
  <div class="container-x">
    <p class="eyebrow !text-accent-light">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl font-display text-5xl font-light leading-[1.05] text-white md:text-7xl">{accent && title.endsWith(accent) ? <>{title.slice(0, -accent.length)}<span class="hero-word">{accent}</span></> : title}</h1>
    {lede && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">{lede}</p>}
    <slot />
    {strip && (
      <div class="mt-12 border-t border-white/20 pt-8">
        <p class="flex items-start gap-4 text-lg leading-relaxed text-white/75">
          <svg class="mt-1 h-6 w-6 shrink-0 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>{strip}</span>
        </p>
      </div>
    )}
  </div>
</section>
