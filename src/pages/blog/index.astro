---
import LocationsSection from '../../components/astro/LocationsSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import PageCta from '../../components/astro/PageCta.astro';
import { posts, categories } from '../../data/blog';
import { parallaxImage } from '../../data/images';
const [featured, ...rest] = posts;
const imgFix = "this.onerror=null;this.src=this.dataset.fb";
---
<BaseLayout overlay title="Pain Management Blog | Choice Pain & Rehabilitation Center" description="Pain care insights and advice from the team at CHOICE Pain & Rehabilitation Center: treatments, conditions, wellness and sports medicine.">
  <PageHero eyebrow="From Our Blog" title="Pain care insights and advice" lede="Practical reading on treatments, conditions and healthy living from our team." image={parallaxImage} />

  <section class="section-pad bg-ivory">
    <div class="container-x">
      <a href={`/blog/${featured.slug}`} class="group grid overflow-hidden rounded-md border border-accent/25 bg-white shadow-xl shadow-navy/10 transition duration-500 hover:shadow-2xl hover:shadow-navy/20 lg:grid-cols-2">
        <div class="aspect-[4/3] overflow-hidden bg-navy lg:aspect-auto"><img src={featured.image} data-fb={featured.fallback} onerror={imgFix} alt="" class="h-full w-full object-cover transition-transform duration-[1400ms] group-hover:scale-105" /></div>
        <div class="flex flex-col justify-center p-8 md:p-12">
          <p class="eyebrow">Latest · {featured.category}</p>
          <h2 class="mt-4 font-display text-4xl leading-tight text-navy md:text-5xl">{featured.title}</h2>
          <p class="mt-5 text-lg text-muted">{featured.excerpt}</p>
          <p class="mt-5 text-sm text-muted">{featured.dateLabel} · {featured.readTime} min read</p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent transition-all group-hover:gap-4">Read article <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <div class="mt-16 flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Filter articles" id="filters">
        <button data-cat="all" class="filter rounded-full border border-accent bg-navy px-5 py-2.5 text-sm font-medium text-white transition">All</button>
        {categories.map((c) => (<button data-cat={c} class="filter rounded-full border border-accent/30 bg-white px-5 py-2.5 text-sm font-medium text-navy transition hover:border-accent hover:bg-cream">{c}</button>))}
      </div>

      <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3" id="grid">
        {rest.map((b) => (
          <li data-cat={b.category}>
            <article class="group h-full overflow-hidden rounded-md border border-accent/25 bg-white transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-navy/15">
              <a href={`/blog/${b.slug}`} class="block" aria-label={b.title}><div class="aspect-[4/3] overflow-hidden bg-navy"><img src={b.image} data-fb={b.fallback} onerror={imgFix} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-110" /></div></a>
              <div class="p-7">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-accent">{b.category} <span class="text-muted">· {b.readTime} min</span></p>
                <h3 class="mt-3 text-2xl leading-snug text-navy"><a href={`/blog/${b.slug}`}>{b.title}</a></h3>
                <p class="mt-3 text-muted">{b.excerpt}</p>
                <a href={`/blog/${b.slug}`} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent transition-all hover:gap-3">Read More <span aria-hidden="true">→</span></a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <LocationsSection />
  <PageCta />
</BaseLayout>
<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.filter'), items = document.querySelectorAll('#grid li');
    btns.forEach(function (b) { b.addEventListener('click', function () {
      var c = b.dataset.cat;
      btns.forEach(function (x) { var on = x === b; x.classList.toggle('bg-navy', on); x.classList.toggle('text-white', on); x.classList.toggle('bg-white', !on); x.classList.toggle('text-navy', !on); });
      items.forEach(function (li) { li.hidden = !(c === 'all' || li.dataset.cat === c); });
    }); });
  })();
</script>
