---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
const { doc } = Astro.props;
---
<BaseLayout overlay title={`${doc.title} | Choice Pain & Rehabilitation Center`} description={doc.lede}>
  <PageHero eyebrow={doc.eyebrow} title={doc.title} lede={doc.lede} image="/images/stock/2756848849.webp" alt="Doctor explaining a spine model to a patient" />
  <section class="section-pad bg-ivory">
    <div class="container-x grid gap-12 lg:grid-cols-[16rem_1fr]">
      <nav aria-label="On this page" class="hidden lg:block"><div class="sticky top-28">
        <p class="eyebrow">On this page</p>
        <ul class="mt-4 divide-y divide-accent/15 border-y border-accent/15 text-sm">
          {doc.sections.map((s, i) => <li><a href={`#s${i + 1}`} class="block py-2.5 text-muted transition hover:text-accent">{s.h}</a></li>)}
        </ul>
        <button type="button" data-open-cookie class="btn btn-outline mt-6 w-full">Cookie Settings</button>
      </div></nav>
      <article class="max-w-3xl">
        <p class="text-sm text-muted">Last updated: {doc.updated}</p>
        {doc.sections.map((s, i) => (
          <section id={`s${i + 1}`} class="mt-10 scroll-mt-28 first:mt-6">
            <h2 class="font-display text-3xl text-navy">{s.h}</h2>
            <div class="accent-rule mt-3"></div>
            {s.p.map((t) => <p class="mt-4 text-lg leading-relaxed text-ink">{t}</p>)}
            {s.list && <ul class="mt-4 list-disc space-y-2 pl-6 text-lg leading-relaxed text-ink marker:text-accent">{s.list.map((t) => <li>{t}</li>)}</ul>}
          </section>
        ))}
        <div class="mt-14 rounded-md border border-accent/25 bg-white p-6 text-muted">
          Questions? Call <a class="text-accent underline" href="tel:+12407861001">(240) 786-1001</a> or email <a class="text-accent underline" href="mailto:info@choicepain.com">info@choicepain.com</a>.
        </div>
      </article>
    </div>
  </section>
  <script>
    document.querySelector('[data-open-cookie]')?.addEventListener('click', () => window.dispatchEvent(new Event('open-cookie-settings')));
  </script>
</BaseLayout>
