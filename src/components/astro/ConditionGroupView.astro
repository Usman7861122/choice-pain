---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PageCta from './PageCta.astro';
import LocationCards from './LocationCards.astro';
import FadeIn from '../react/FadeIn';
import ServicesGrid from '../react/ServicesGrid';
import { photoStatus } from '../../data/photo-status';
import { site } from '../../data/content';
import { conditionGroups } from '../../data/condition-groups';
import { conditionPages } from '../../data/condition-pages';
import { conditions } from '../../data/conditions';
import { locations } from '../../data/locations';
import { localAreas } from '../../data/local-areas';
const { g, loc: locSlug } = Astro.props;
const loc = locSlug ? locations.find((l) => l.slug === locSlug) : undefined;
const local = locSlug ? localAreas[locSlug] : undefined;
const here = loc && local;
const base = `/conditions/${g.slug}`;
const list = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}` : a[0]);
const h1 = here ? `${g.title} Care in ${local!.city}` : `${g.title} Conditions`;
const metaTitle = here ? `${g.title} Pain Treatment in ${loc!.name} | Choice Pain & Rehabilitation Center` : `${g.title} Pain Treatment in Maryland & Delaware | Choice Pain & Rehabilitation Center`;
const metaDescription = here ? `${g.title} conditions we treat in ${loc!.name}: ${g.short} Call ${site.phone}.` : `${g.short} Gentle, non-surgical care at 10 offices in Maryland and Delaware.`;
const strip = here ? `Patients are welcome from across ${list(local!.areas)} and the greater ${local!.city} area.` : 'Patients are welcome from across Maryland and Delaware, including Hyattsville, Gaithersburg, Baltimore, Newark, Milford and the surrounding areas.';
const items = g.conditions.map((s) => { const pg = conditionPages[s]; return { slug: s, title: conditions.find((c) => c.slug === s)!.title, text: pg.short || '', img: pg.photos[0].img }; });
const st = (i: number) => photoStatus(`/images/stock/${g.photos[i]}.webp`);
const src = (i: number) => `/images/stock/${g.photos[i]}.webp`;
const others = conditionGroups.filter((x) => x.slug !== g.slug);
const schema = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: metaTitle, description: metaDescription };
---
<BaseLayout overlay title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <PageHero eyebrow={here ? `Conditions · ${loc!.name}` : 'Conditions · Maryland & Delaware'} title={h1} accent={here ? local!.city : undefined} strip={strip} lede={here ? `${g.lede} Our ${local!.city} office welcomes patients from ${local!.areas.slice(0, 4).join(', ')} and nearby.` : g.lede} image={src(0)} alt={g.alts[0]}>
    <div class="mt-8 flex flex-wrap gap-3"><a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a><a href={site.phoneHref} class="btn btn-light">Call {site.phone}</a></div>
  </PageHero>

  <section class="section-pad bg-ivory" aria-labelledby="g-ov">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <FadeIn client:visible>
        <p class="eyebrow">Overview</p>
        <h2 id="g-ov" class="section-title mt-3">{g.title} care at Choice Pain</h2>
        <div class="accent-rule mt-6"></div>
        {g.overview.map((t) => <p class="mt-5 text-lg leading-relaxed text-muted">{t}</p>)}
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-md border border-accent/25 bg-white p-6 transition duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-navy/10"><p class="font-display text-5xl text-accent">{g.conditions.length}</p><p class="mt-1 text-muted">conditions we treat in this group</p></div>
          <div class="rounded-md border border-accent/25 bg-white p-6 transition duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-navy/10"><p class="font-display text-5xl text-accent">10</p><p class="mt-1 text-muted">offices in Maryland and Delaware</p></div>
        </div>
        <p class="mt-8 border-l-4 border-accent pl-5 font-display text-2xl text-navy">Our approach: {g.approach}</p>
      </FadeIn>
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={src(1)} data-photo-status={st(1)} alt={g.alts[1]} class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
    </div>
  </section>

  <section class="section-pad relative isolate overflow-hidden bg-navy text-white" aria-labelledby="g-list">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="eyebrow !text-accent-light">Conditions</p>
        <h2 id="g-list" class="font-display text-4xl text-white md:text-5xl">Conditions in {g.title}</h2>
        <div class="accent-rule mx-auto mt-6"></div>
        <p class="mt-6 text-lg text-white/80">Choose a condition to learn about causes, symptoms and treatment.</p>
      </div>
      <ServicesGrid client:visible items={items} base="/conditions" />
    </div>
  </section>

  <section class="section-pad bg-cream" aria-labelledby="g-tx">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="overflow-hidden rounded-md shadow-2xl shadow-navy/20"><img src={src(2)} data-photo-status={st(2)} alt={g.alts[2]} class="aspect-[4/5] w-full object-cover" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Treatment</p>
        <h2 id="g-tx" class="section-title mt-3">Gentle care, step by step</h2>
        <div class="accent-rule mt-6"></div>
        <p class="mt-6 text-lg leading-relaxed text-muted">We always start with the least invasive treatment likely to help. Depending on your diagnosis, your plan may include these treatments.</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {['epidural-steroid-injections|Epidural Steroid Injections', 'radiofrequency-ablation|Radiofrequency Ablation', 'spinal-cord-stimulation|Spinal Cord Stimulation', 'mild-procedure|MILD® Procedure', 'kyphoplasty|Kyphoplasty', 'regenerative-medicine|Regenerative Medicine & Joints'].map((x) => { const [s, t] = x.split('|'); return <li><a href={`/services/${s}`} class="flex items-center justify-between gap-3 rounded-md border border-accent/25 bg-white p-4 text-navy transition duration-500 hover:-translate-y-1 hover:border-accent hover:shadow-xl hover:shadow-navy/10">{t}<span class="text-accent" aria-hidden="true">→</span></a></li>; })}
        </ul>
      </div>
    </div>
  </section>

  <LocationCards title={g.title} base={base} loc={locSlug} />

  <section class="section-pad bg-cream" aria-labelledby="g-more">
    <div class="container-x text-center">
      <p class="eyebrow">More conditions</p><h2 id="g-more" class="section-title">Explore other condition groups</h2><div class="accent-rule mx-auto mt-6"></div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">{others.map((o) => <a href={`/conditions/${o.slug}`} class="rounded-full border border-accent/40 px-6 py-2.5 text-navy transition hover:bg-accent hover:text-white">{o.title}</a>)}</div>
    </div>
  </section>
  <PageCta />
</BaseLayout>
