---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import PageCta from '../../components/astro/PageCta.astro';
import FadeIn from '../../components/react/FadeIn';
import ServicesGrid from '../../components/react/ServicesGrid';
import LocationsSection from '../../components/astro/LocationsSection.astro';
import { conditionGroups } from '../../data/condition-groups';
import { conditions } from '../../data/conditions';
import { site } from '../../data/content';
const strip = 'Patients are welcome from across Maryland and Delaware, including Hyattsville, Gaithersburg, Baltimore, Newark, Milford and the surrounding areas.';
const items = conditionGroups.map((g) => ({ slug: g.slug, title: g.title, text: g.short, img: `/images/stock/${g.photos[0]}.webp` }));
---
<BaseLayout overlay title="Conditions We Treat | Choice Pain & Rehabilitation Center" description="Back, neck, joint and nerve pain, headache, injuries and more. Find your condition and the gentlest care that works at 10 offices in Maryland and Delaware.">
  <PageHero eyebrow="Conditions · Maryland & Delaware" title="Conditions We Treat" strip={strip} lede="Find the pain you are living with. We look for the true source and offer the gentlest care that works." image={`/images/stock/${conditionGroups[0].photos[0]}.webp`} alt={conditionGroups[0].alts[0]}>
    <div class="mt-8 flex flex-wrap gap-3"><a href={site.appointmentHref} class="btn btn-appointment">Request Appointment</a><a href={site.phoneHref} class="btn btn-light">Call {site.phone}</a></div>
  </PageHero>
  <section class="section-pad bg-ivory">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow">Browse by area</p><h2 class="section-title">Six groups of conditions</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <ServicesGrid client:visible items={items} base="/conditions" />
    </div>
  </section>
  <section class="section-pad bg-cream">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow">All conditions</p><h2 class="section-title">Every condition, A to Z</h2><div class="accent-rule mx-auto mt-6"></div></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[...conditions].sort((a, b) => a.title.localeCompare(b.title)).map((c) => <a href={`/conditions/${c.slug}`} class="flex items-center justify-between gap-3 rounded-md border border-accent/25 bg-white p-5 text-navy transition duration-500 hover:-translate-y-1 hover:border-accent hover:shadow-xl hover:shadow-navy/10">{c.title}<span class="text-accent" aria-hidden="true">→</span></a>)}
      </div>
    </div>
  </section>
  <LocationsSection />
  <PageCta />
</BaseLayout>
